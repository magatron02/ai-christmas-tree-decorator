.env
data/
storage/
*.db
*.db-wal
*.db-shm

scripts/risk_gate_output.png
scripts/risk_gate_*.png
launcher.log

# AC-5 material: catalogue exports in, generated results out. Both are large image sets,
# and the verdicts that matter live in results.csv, which you can copy out by hand.
ac5-source/
ac5-results/

.venv/
__pycache__/
*.pyc
.pytest_cache/

# catalog/products.json and product_images.json ARE committed on purpose: they are the
# deliverable of Product.md 8.1, and the 200 MB PDF they come from is not in the repo.
# The crops are not — 105 MB of pictures that scripts/build_product_index.py regenerates
# from the PDF, and the JSON already records which crop belongs to which code.
catalog/images/
# derived from catalog/images/ by scripts/precut_catalog.py, same reason: pictures, rebuildable
catalog/cutouts/
# embeddings are a derived binary rebuilt by scripts/embed_catalog.py from descriptions.json
catalog/embeddings.npy
catalog/embedding_codes.json
catalog.legacy-backup/
catalog-images*.zip

# graft's local graph cache — regenerable, not committed (run `graft build`).
graft/

# Supplier wholesale price lists (vrtwins360 internal use only) — a separate data source
# from catalog/, never merged into catalog/products.json itself (different codes, different
# shop). The source PDF and the full parsed CSV stay out of git entirely: the supplier's own
# sheet, names/categories/pack-sizes and all, is not this project's deliverable to publish.
#
# cleaned/lookup.json is the one deliberate exception (2026-09-10 decision) — a minimal
# code -> {price, size_mm} mapping build_lookup.py derives from that CSV, committed so the
# app's own price/size lookup (backend/services/vendor_lookup.py, now the exclusive source
# for both — see docs/NonGoals.md 8) has something to read on a machine that only ever clones
# the repo. See vendor-pricelists/bangkok-christmas/README.md.
vendor-pricelists/*
!vendor-pricelists/bangkok-christmas/
vendor-pricelists/bangkok-christmas/*
# committed alongside the data it produces, so "re-run this when the price list changes"
# (its own docstring) is something a later clone can actually do — no vendor data in it
!vendor-pricelists/bangkok-christmas/build_lookup.py
!vendor-pricelists/bangkok-christmas/cleaned/
vendor-pricelists/bangkok-christmas/cleaned/*
!vendor-pricelists/bangkok-christmas/cleaned/lookup.json

# Desktop build (scripts/launcher.py + TreeDecorator.spec + installer/TreeDecorator.iss are
# the sources and ARE committed; everything below is regenerated by building them).
build/
dist/
dist_installer/
build_assets/
build_pyinstaller.log
